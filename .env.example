# Resend API key for the Coming Soon / waitlist email capture (/api/subscribe)
# Dedicated full_access key, separate from the transactional-sending key
# used by Supabase SMTP — least-privilege, independently revocable.
# Requires a Contact Property named "source" to exist in Resend first
# (Dashboard → Contacts → Properties, or via resend.contactProperties.create).
RESEND_API_KEY=

# Resend verified sender for the waitlist welcome email (/api/subscribe).
# Must be on a verified Resend sending domain (send.trymurmur.studio).
# Set the same value in Vercel (Production + Preview).
RESEND_FROM="Murmur <hello@send.trymurmur.studio>"

# PostHog (www) — client SDK; also set on Vercel www project (Production + Preview).
# Do not commit real keys. EU cloud host:
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
