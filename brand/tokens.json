  "source": "src/app/globals.css (the website is the source of truth; keep these in sync)",
  "color": {
    "dark": {
      "bg": "#0a0a0b",
      "bg-2": "#0e0e10",
      "surface": "#131315",
      "surface-2": "#19191c",
      "surface-3": "#212125",
      "line": "rgba(255,255,255,0.08)",
      "line-2": "rgba(255,255,255,0.15)",
      "fg": "#f4f2ed",
      "fg-2": "#b9b6af",
      "fg-3": "#8a877f",
      "signal": "#ff5a2c",
      "on-signal": "#170903",
      "ok": "#43d692"
    },
    "light": {
      "bg": "#f3f0e9",
      "bg-2": "#ebe7de",
      "surface": "#faf8f4",
      "surface-2": "#ffffff",
      "surface-3": "#efebe3",
      "line": "rgba(26,24,20,0.10)",
      "line-2": "rgba(26,24,20,0.18)",
      "fg": "#141311",
      "fg-2": "#48453f",
      "fg-3": "#6b675f",
      "signal": "#f2481b",
      "on-signal": "#170903",
      "ok": "#1f9d63"
    }
  },
  "font": {
    "display": { "family": "Bricolage Grotesque", "weight": 600, "tracking": "-0.03em", "wdth": 88, "use": "Headlines, the wordmark" },
    "accent": { "family": "Instrument Serif", "style": "italic", "weight": 400, "use": "One word or phrase per headline, in signal" },
    "body": { "family": "Geist", "weight": "400–500", "use": "Body copy, captions, buttons" },
    "mono": { "family": "Geist Mono", "weight": 500, "tracking": "0.12em", "case": "uppercase", "use": "Labels, stage lines, URLs, honesty labels" }
  },
  "radius": { "pill": "999px", "card": "20px", "chip": "12px" },
  "mark": {
    "bars": 5,
    "viewBox": "0 0 27 24",
    "centreBar": "signal",
    "otherBars": "fg"
  }
